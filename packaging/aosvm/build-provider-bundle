# SPDX-License-Identifier: Apache-2.0

set -eu
umask 077

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH='' cd -- "$script_dir/../.." && pwd)
python=${PYTHON:-python3}
output_root=${1:-"$repository_root/build/aosvm"}
requirements="$script_dir/runtime/requirements-arm64.txt"
bundle_root="$output_root/carla-kuksa-provider-0.1.0-arm64"
archive="$output_root/carla-kuksa-provider-0.1.0-arm64.tar.gz"
bundle_parent=''

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

cleanup() {
    if [ -n "$bundle_parent" ] && [ -d "$bundle_parent" ]; then
        rm -rf "$bundle_parent"
    fi
}
trap cleanup EXIT HUP INT TERM

command -v "$python" >/dev/null 2>&1 || fail "Python is unavailable: $python"
"$python" -m pip --version >/dev/null 2>&1 || fail 'Python pip is unavailable'
mkdir -p "$output_root"
bundle_parent=$(mktemp -d "$output_root/.provider-bundle.XXXXXX")
wheels="$bundle_parent/wheels"
mkdir -p "$wheels"

"$python" -m pip download \
    --dest "$wheels" \
    --no-deps \
    --only-binary=:all: \
    --platform manylinux2014_aarch64 \
    --python-version 3.12 \
    --implementation cp \
    --abi cp312 \
    --require-hashes \
    --requirement "$requirements"

bundle_root="$bundle_parent/carla-kuksa-provider-0.1.0-arm64"
mkdir -p "$bundle_root/app" "$bundle_root/wheels" "$bundle_root/packaging"
cp -R "$repository_root/providers/carla-viss-kuksa/src/carla_viss_kuksa_provider" \
    "$bundle_root/app/"
cp "$requirements" "$bundle_root/requirements-arm64.txt"
cp "$wheels"/*.whl "$bundle_root/wheels/"
cp "$repository_root/providers/carla-viss-kuksa/config/aosvm.json" \
    "$bundle_root/config.json"
cp "$script_dir/carla-kuksa-provider.service" \
    "$bundle_root/packaging/carla-kuksa-provider.service"
cp "$script_dir/kuksa-databroker-jwt.conf" \
    "$bundle_root/packaging/kuksa-databroker-jwt.conf"
cp "$script_dir/verify-runtime.py" "$bundle_root/packaging/verify-runtime.py"
cp "$script_dir/install-provider" "$bundle_root/install-provider"
cp "$script_dir/uninstall-provider" "$bundle_root/uninstall-provider"
cp "$repository_root/DEPENDENCIES.json" "$bundle_root/DEPENDENCIES.json"
cp "$repository_root/THIRD_PARTY_NOTICES.md" "$bundle_root/THIRD_PARTY_NOTICES.md"
chmod 0755 "$bundle_root/install-provider" "$bundle_root/uninstall-provider"

"$python" "$script_dir/create-reproducible-tar.py" "$bundle_root" "$archive"
printf 'Created ARM64 AosVM provider bundle: %s\n' "$archive"
