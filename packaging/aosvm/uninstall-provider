set -eu
umask 077

unit=/etc/systemd/system/carla-kuksa-provider.service
drop_in=/etc/systemd/system/kuksa-databroker.service.d/20-aos-vehicle-platform-jwt.conf
root_remounted_rw=0

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

cleanup() {
    if [ "$root_remounted_rw" -eq 1 ]; then
        mount -o remount,ro / >/dev/null 2>&1 || true
    fi
}
trap cleanup EXIT HUP INT TERM

[ "$(uname -m)" = aarch64 ] || fail 'the rollback requires an AArch64 guest'
findmnt -n -o OPTIONS / | tr ',' '\n' | grep -qx ro ||
    fail 'the root filesystem must be read-only before rollback'

if systemctl cat carla-kuksa-provider.service >/dev/null 2>&1; then
    systemctl stop carla-kuksa-provider.service
fi

mount -o remount,rw / || fail 'cannot remount the root filesystem read-write'
root_remounted_rw=1
if systemctl cat carla-kuksa-provider.service >/dev/null 2>&1; then
    systemctl disable carla-kuksa-provider.service >/dev/null 2>&1 || true
fi
rm -f "$unit" "$drop_in"
mount -o remount,ro / || fail 'cannot return the root filesystem to read-only mode'
root_remounted_rw=0

systemctl daemon-reload
systemctl reset-failed carla-kuksa-provider.service >/dev/null 2>&1 || true
systemctl restart kuksa-databroker.service
systemctl is-active --quiet kuksa-databroker.service ||
    fail 'KUKSA Databroker did not recover with the image-default verifier'

printf '%s\n' 'Removed the AOS-2 systemd integration and restored KUKSA image defaults.'
printf '%s\n' 'Versioned runtime and credentials remain under /var for forensic rollback.'
