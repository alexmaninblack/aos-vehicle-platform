/usr/libexec/aos-vision-exchange-launcher -- gen_context(system_u:object_r:vision_exchange_exec_t,s0)
/run/aos-vision-exchange -d gen_context(system_u:object_r:vision_exchange_runtime_t,s0)
/run/aos-vision-exchange/(perception-publish|perception-read|context-read|assessment-publish)(/.*)? gen_context(system_u:object_r:vision_exchange_socket_t,s0)
/var/aos/downloads/vision-services(/.*)? gen_context(system_u:object_r:aos_var_run_t,s0)
