+TEST_F(SMControllerTest, ConcurrentCloudStatusAndNodeConfigWrites)
+{
+    SMClientStub client;
+    ASSERT_TRUE(client.Init(cMainNodeID).IsNone());
+    ASSERT_TRUE(client.Start(mConfig.mCMServerURL).IsNone());
+    ASSERT_TRUE(mSMInfoReceiver.WaitSMInfo(cMainNodeID).IsNone());
+    ASSERT_TRUE(client.WaitCloudConnection().IsNone());
+
+    // Exercise the two real server-side writers on the same gRPC stream.
+    // Each synchronous request must receive its response while OnConnect
+    // independently sends asynchronous Cloud status notifications.
+    std::atomic<bool> ready {false};
+    std::atomic<bool> start {false};
+    std::atomic<unsigned> failures {0};
+    std::thread cloudWriter([&] {
+        ready = true;
+        while (!start.load()) {
+            std::this_thread::yield();
+        }
+        for (unsigned i = 0; i < 5000; ++i) {
+            mCloudConnection.TriggerConnect();
+            std::this_thread::yield();
+        }
+    });
+    while (!ready.load()) {
+        std::this_thread::yield();
+    }
+    start = true;
+    for (unsigned i = 0; i < 1000; ++i) {
+        NodeConfigStatus status;
+        if (!mSMController.GetNodeConfigStatus(cMainNodeID, status).IsNone()) {
+            ++failures;
+            break;
+        }
+    }
+    cloudWriter.join();
+    EXPECT_EQ(failures.load(), 0U);
+    EXPECT_TRUE(client.WaitCloudConnection().IsNone());
+    EXPECT_TRUE(client.Stop().IsNone());
+    EXPECT_TRUE(mSMInfoReceiver.WaitDisconnect(cMainNodeID).IsNone());
+}
