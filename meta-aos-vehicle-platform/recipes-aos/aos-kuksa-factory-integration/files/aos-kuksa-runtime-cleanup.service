[Unit]
Description=Remove KUKSA runtime state and per-vehicle TLS identity on deprovision

[Service]
Type=oneshot
ExecStart=/usr/libexec/aos-kuksa-runtime-cleanup
TimeoutStartSec=10s
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
# Deprovision is valid even if one or more runtime paths were never created.
ReadWritePaths=-/run/aos-kuksa-auth-compat -/run/aos-kuksa-verifier -/var/lib/aos-kuksa-provider -/var/lib/aos-kuksa-tls /var/lib/softhsm
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=8
LimitNOFILE=32
