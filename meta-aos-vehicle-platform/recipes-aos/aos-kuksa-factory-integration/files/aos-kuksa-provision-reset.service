[Unit]
Description=Reset unprovisioned Aos state before KUKSA token initialization
ConditionPathExists=!/var/aos/.provisionstate
Before=aos-kuksa-token-init.service

[Service]
Type=oneshot
ExecStart=/opt/aos/deprovision.sh
ExecStartPost=/usr/bin/install -d -m 0700 -o root -g root /var/aos/iam
RemainAfterExit=yes
TimeoutStartSec=45s
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
