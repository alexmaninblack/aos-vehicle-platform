[Unit]
Description=Prepare the isolated Aos vehicle data provider store
DefaultDependencies=no
Requires=var-aos-workdirs.mount
After=var-aos-workdirs.mount systemd-modules-load.service
Before=aos-vehicle-data-provider-bootstrap.service aos-sm.service
ConditionPathIsMountPoint=/var/aos/workdirs

[Service]
Type=oneshot
ExecStart=/usr/libexec/aos-vehicle-data-provider-store-prepare prepare
ExecStop=/usr/libexec/aos-vehicle-data-provider-store-prepare release
RemainAfterExit=yes
UMask=0077
RuntimeDirectory=aos-vehicle-data-provider-store
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=/var/aos/workdirs/sm/runtimes /run/aos-vehicle-data-provider-store
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SYS_ADMIN
AmbientCapabilities=
