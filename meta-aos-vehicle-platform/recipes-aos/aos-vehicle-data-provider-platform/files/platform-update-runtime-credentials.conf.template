# Inert credential contract. This file is deliberately installed outside every
# systemd unit search path and must not be activated before its sources exist.
[Service]
LoadCredential=viss-update-ca:/var/aos/iam/vehicle-state/platform-update-runtime/ca.pem
LoadCredential=viss-update-certificate:/var/aos/iam/vehicle-state/platform-update-runtime/client.pem
LoadCredential=viss-update-private-key:/var/aos/iam/vehicle-state/platform-update-runtime/client-key.pem
LoadCredential=viss-update-binding:/var/aos/iam/vehicle-state/platform-update-runtime/binding.json
