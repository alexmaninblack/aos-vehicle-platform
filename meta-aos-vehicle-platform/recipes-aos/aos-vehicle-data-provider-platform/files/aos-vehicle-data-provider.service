[Unit]
Description=Aos vehicle data provider component
Documentation=https://github.com/alexmaninblack/aos-vehicle-platform
After=network-online.target kuksa-databroker.service
Wants=network-online.target
Requires=kuksa-databroker.service
ConditionPathIsSymbolicLink=/var/aos/workdirs/sm/runtimes/systemd-slot-component/active
ConditionFileIsExecutable=/var/aos/workdirs/sm/runtimes/systemd-slot-component/active/bin/vehicle-data-provider

[Service]
Type=notify
NotifyAccess=main
User=aos-vdp
Group=aos-vdp
Environment=AOS_VEHICLE_DATA_PROVIDER_CONFIGURATION=/var/aos/workdirs/sm/runtimes/systemd-slot-component/configuration/provider.json
Environment=AOS_VEHICLE_DATA_PROVIDER_VISS_CA=/var/aos/workdirs/sm/runtimes/systemd-slot-component/trust/viss-ca.pem
# The ! prefix lets only the audited launcher enter its SELinux domain as root.
# It enables no_new_privs and irreversibly drops to aos-vdp before the payload.
ExecStart=!/usr/libexec/aos-vehicle-data-provider-launcher
ExecReload=/bin/kill -HUP $MAINPID
LoadCredential=kuksa-token:/var/aos/workdirs/sm/runtimes/systemd-slot-component/credentials/kuksa-token
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=8s
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_SETGID CAP_SETUID
AmbientCapabilities=

[Install]
# The Service Manager runtime owns activation. This unit must not be enabled.
