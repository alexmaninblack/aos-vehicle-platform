+TEST_F(PublicMessageHandlerTest, RepliesWithAll32LongFunctionKeysWithoutTruncation)
+{
+    auto clientStub = CreateClientStub<iamproto::IAMPublicPermissionsService>();
+    ASSERT_NE(clientStub, nullptr);
+    for (size_t count : {17U, 32U}) {
+        grpc::ClientContext context;
+        context.set_deadline(std::chrono::system_clock::now() + std::chrono::seconds(3));
+        iamproto::PermissionsRequest request;
+        iamproto::PermissionsResponse response;
+        std::vector<std::string> keys;
+        for (size_t i = 0; i < count; ++i) {
+            auto suffix = std::to_string(i);
+            keys.push_back(std::string(256 - suffix.size(), 'x') + suffix);
+        }
+        EXPECT_CALL(mPermHandler, GetPermissions)
+            .WillOnce(Invoke([&](const String&, const String&, InstanceIdent&, Array<FunctionPermissions>& permissions) {
+                for (const auto& key : keys) {
+                    if (auto err = permissions.PushBack({key.c_str(), "r"}); !err.IsNone()) {
+                        return err;
+                    }
+                }
+                return Error(ErrorEnum::eNone);
+            }));
+        ASSERT_TRUE(clientStub->GetPermissions(&context, request, &response).ok());
+        const auto& result = response.permissions().permissions();
+        ASSERT_EQ(result.size(), count);
+        for (const auto& key : keys) {
+            ASSERT_NE(result.find(key), result.end());
+            EXPECT_EQ(result.at(key), "r");
+        }
+    }
+}
