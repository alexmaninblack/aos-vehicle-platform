+++ b/src/sm/networkmanager/tests/namespacecleanup.cpp
@@ -0,0 +1,63 @@
+/*
+ * Copyright (C) 2026 EPAM Systems, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <filesystem>
+#include <fstream>
+#include <sys/mount.h>
+#include <unistd.h>
+#include <gtest/gtest.h>
+#include <common/network/namespacemanager.hpp>
+
+class NamespaceCleanupTest : public testing::Test {
+protected:
+    void SetUp() override
+    {
+        if (geteuid() != 0) { GTEST_SKIP() << "requires isolated root test environment"; }
+        name = "aos-cleanup-test-" + std::to_string(getpid());
+        path = std::filesystem::path("/run/netns") / name;
+        ASSERT_FALSE(std::filesystem::exists(path));
+        std::filesystem::create_directories(path.parent_path());
+    }
+    void TearDown() override
+    {
+        if (!path.empty()) {
+            if (mounted) { umount2(path.c_str(), MNT_DETACH); }
+            std::filesystem::remove(path);
+        }
+    }
+    aos::common::network::NamespaceManager manager;
+    std::string name;
+    std::filesystem::path path;
+    bool mounted = false;
+};
+
+TEST_F(NamespaceCleanupTest, MissingNamespaceIsIdempotent)
+{
+    EXPECT_TRUE(manager.DeleteNetworkNamespace(name.c_str()).IsNone());
+}
+
+TEST_F(NamespaceCleanupTest, EmptyUnmountedPlaceholderIsRemoved)
+{
+    std::ofstream(path).close();
+    EXPECT_TRUE(manager.DeleteNetworkNamespace(name.c_str()).IsNone());
+    EXPECT_FALSE(std::filesystem::exists(path));
+    EXPECT_TRUE(manager.DeleteNetworkNamespace(name.c_str()).IsNone());
+}
+
+TEST_F(NamespaceCleanupTest, NonemptyFileIsPreserved)
+{
+    std::ofstream(path) << "not a namespace placeholder";
+    EXPECT_EQ(manager.DeleteNetworkNamespace(name.c_str()).Errno(), EINVAL);
+    EXPECT_TRUE(std::filesystem::exists(path));
+}
+
+TEST_F(NamespaceCleanupTest, MountedNamespaceIsUnmountedNormally)
+{
+    std::ofstream(path).close();
+    ASSERT_EQ(mount("/proc/self/ns/net", path.c_str(), nullptr, MS_BIND, nullptr), 0);
+    mounted = true;
+    EXPECT_TRUE(manager.DeleteNetworkNamespace(name.c_str()).IsNone());
+    EXPECT_FALSE(std::filesystem::exists(path));
+    mounted = false;
+}
