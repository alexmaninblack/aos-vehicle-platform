+/*
+ * Copyright (C) 2026 EPAM Systems, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#ifndef AOS_SM_CONTAINER_CLEANUPERROR_HPP_
+#define AOS_SM_CONTAINER_CLEANUPERROR_HPP_
+
+#include <core/common/tools/error.hpp>
+
+namespace aos::sm::launcher::detail {
+
+// Only the crun adapter uses this policy. An internal ENOENT is not proof
+// that a container is absent; the caller must check its exact state directory.
+inline Error NormalizeCleanupError(const Error& error, bool stateAbsent, bool stopping)
+{
+    if ((stopping && error.Errno() == ESRCH) || (stateAbsent && error.Errno() == ENOENT)) {
+        return ErrorEnum::eNotFound;
+    }
+    return error;
+}
+
+} // namespace aos::sm::launcher::detail
+#endif
