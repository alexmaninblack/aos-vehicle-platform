+/*
+ * SPDX-FileCopyrightText: 2026 maninblack
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <unistd.h>
+#include <gtest/gtest.h>
+#include <core/common/tests/utils/log.hpp>
+#include <sm/launcher/runtimes/container/crunrunner.hpp>
+#include <sm/launcher/runtimes/container/libcrun.hpp>
+
+namespace {
+int injectedError = EIO;
+bool failCall = true;
+int FailOrSucceed(libcrun_error_t* error)
+{
+    if (!failCall) {
+        return 0;
+    }
+    *error = static_cast<libcrun_error_t>(std::calloc(1, sizeof(libcrun_error_s)));
+    (*error)->status = injectedError;
+    (*error)->msg = ::strdup("isolated crun error injection");
+    return -1;
+}
+}
+
+extern "C" int __wrap_libcrun_container_kill(libcrun_context_t*, const char*, const char*, libcrun_error_t* error)
+{
+    return FailOrSucceed(error);
+}
+extern "C" int __wrap_libcrun_container_delete(
+    libcrun_context_t*, runtime_spec_schema_config_schema*, const char*, bool, libcrun_error_t* error)
+{
+    return FailOrSucceed(error);
+}
+
+class CrunAdapterTest : public testing::Test {
+protected:
+    void SetUp() override
+    {
+        aos::tests::utils::InitLog();
+        char pattern[] = "/tmp/mainline-crun-adapter-XXXXXX";
+        auto* directory = ::mkdtemp(pattern);
+        ASSERT_NE(directory, nullptr);
+        root = directory;
+        failCall = true;
+        injectedError = EIO;
+        ASSERT_TRUE(runner.Init(root.string(), root.string(), "/not-executed").IsNone());
+        ASSERT_TRUE(runner.AddContainer("service").IsNone());
+    }
+    void TearDown() override
+    {
+        if (!root.empty()) {
+            std::filesystem::remove_all(root);
+        }
+    }
+    aos::sm::launcher::CRunRunner runner;
+    std::filesystem::path root;
+};
+
+TEST_F(CrunAdapterTest, AbsentStateIsIdempotent)
+{
+    injectedError = ENOENT;
+    EXPECT_TRUE(runner.StopContainer("service").Is(aos::ErrorEnum::eNotFound));
+    EXPECT_TRUE(runner.RemoveContainer("service").IsNone());
+    EXPECT_TRUE(runner.ListContainers().mValue.empty());
+}
+
+TEST_F(CrunAdapterTest, MissingInternalFileDoesNotMeanMissingContainer)
+{
+    std::filesystem::create_directory(root / "service");
+    injectedError = ENOENT;
+    EXPECT_EQ(runner.StopContainer("service").Errno(), ENOENT);
+    EXPECT_EQ(runner.RemoveContainer("service").Errno(), ENOENT);
+    EXPECT_EQ(runner.ListContainers().mValue.size(), 1U);
+}
+
+TEST_F(CrunAdapterTest, FailureRetainsOwnershipUntilSuccessfulRetry)
+{
+    std::filesystem::create_directory(root / "service");
+    for (int code : {EPERM, EACCES, EIO, EINVAL}) {
+        injectedError = code;
+        EXPECT_EQ(runner.StopContainer("service").Errno(), code);
+        EXPECT_EQ(runner.RemoveContainer("service").Errno(), code);
+        EXPECT_EQ(runner.ListContainers().mValue.size(), 1U);
+    }
+    failCall = false;
+    EXPECT_TRUE(runner.RemoveContainer("service").IsNone());
+    EXPECT_TRUE(runner.ListContainers().mValue.empty());
+}
+
+TEST_F(CrunAdapterTest, ExitedProcessIsAbsentOnlyForStop)
+{
+    std::filesystem::create_directory(root / "service");
+    injectedError = ESRCH;
+    EXPECT_TRUE(runner.StopContainer("service").Is(aos::ErrorEnum::eNotFound));
+    EXPECT_EQ(runner.RemoveContainer("service").Errno(), ESRCH);
+    EXPECT_EQ(runner.ListContainers().mValue.size(), 1U);
+}
+
+TEST_F(CrunAdapterTest, ErrorWithoutErrnoIsStillFailure)
+{
+    injectedError = 0;
+    EXPECT_TRUE(runner.StopContainer("service").Is(aos::ErrorEnum::eFailed));
+    EXPECT_TRUE(runner.RemoveContainer("service").Is(aos::ErrorEnum::eFailed));
+    EXPECT_EQ(runner.ListContainers().mValue.size(), 1U);
+}
