+bool CRunRunner::IsMissingState(const std::string& instanceID, const Error& error) const
+{
+    if (error.Errno() != ENOENT) {
+        return false;
+    }
+
+    // Do not turn an internal missing file or an inaccessible state into success.
+    struct stat state {};
+    const auto path = std::string(cStateRoot) + "/" + instanceID;
+    return lstat(path.c_str(), &state) < 0 && errno == ENOENT;
+}
