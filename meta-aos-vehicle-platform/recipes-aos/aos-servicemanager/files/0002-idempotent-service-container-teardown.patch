+/*
+ * Copyright (C) 2026 EPAM Systems, Inc.
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include <gtest/gtest.h>
+#include <sm/launcher/runtimes/container/cleanuperror.hpp>
+
+using namespace aos;
+using aos::sm::launcher::detail::NormalizeCleanupError;
+
+TEST(ContainerCleanupErrorTest, ExitedProcessIsAbsentOnlyForStop)
+{
+    EXPECT_TRUE(NormalizeCleanupError(Error(ESRCH), false, true).Is(ErrorEnum::eNotFound));
+    EXPECT_EQ(NormalizeCleanupError(Error(ESRCH), false, false).Errno(), ESRCH);
+}
+
+TEST(ContainerCleanupErrorTest, MissingStateIsAbsentButMissingInternalFileIsNot)
+{
+    for (bool stopping : {false, true}) {
+        EXPECT_TRUE(NormalizeCleanupError(Error(ENOENT), true, stopping).Is(ErrorEnum::eNotFound));
+        EXPECT_EQ(NormalizeCleanupError(Error(ENOENT), false, stopping).Errno(), ENOENT);
+    }
+}
+
+TEST(ContainerCleanupErrorTest, RealErrorsAreNeverSuppressed)
+{
+    for (int code : {EPERM, EACCES, EIO, EINVAL}) {
+        for (bool stopping : {false, true}) {
+            EXPECT_EQ(NormalizeCleanupError(Error(code), true, stopping).Errno(), code);
+        }
+    }
+}
