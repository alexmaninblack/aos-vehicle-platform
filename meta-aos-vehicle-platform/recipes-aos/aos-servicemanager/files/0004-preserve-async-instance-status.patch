+TEST_F(LauncherTest, AsyncComponentStartMustNotBeReportedActive)
+{
+    const auto info = CreateInstanceInfo("vdp", 0, "109.0.0", "runtime0", UpdateItemTypeEnum::eComponent);
+    const std::vector stored = {info};
+    mStorage.Init(stored);
+    const auto waiting = CreateInstanceStatus(info, InstanceStateEnum::eActivating, UpdateItemTypeEnum::eComponent);
+    EXPECT_CALL(mRuntime0, StartInstance).WillOnce(DoAll(SetArgReferee<1>(waiting), Return(ErrorEnum::eNone)));
+
+    ASSERT_TRUE(mLauncher.Init(mAllocator, GetRuntimesArray(), mImageManager, mSender, mStorage, mOCISpec,
+        mItemInfoProvider, mCloudConnection, mNetworkManager, mInstanceIDProvider, mResourceInfoProvider).IsNone());
+    ASSERT_TRUE(mLauncher.Start().IsNone());
+    EXPECT_TRUE(mLauncher.GetInstancesStatuses(mReceivedStatuses).IsNone());
+    EXPECT_EQ(mReceivedStatuses.Size(), 1);
+    if (mReceivedStatuses.Size() == 1) {
+        EXPECT_EQ(mReceivedStatuses[0], waiting);
+    }
+    EXPECT_CALL(mRuntime0, StopInstance).Times(0);
+    EXPECT_TRUE(mLauncher.Stop().IsNone());
+}
