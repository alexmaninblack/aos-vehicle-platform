Use the native instance identity for the exact platform-owned KAC token tmpfs.
Keep the resource declaration unchanged and reject conflicting token mounts.
Upstream-Status: Inappropriate [platform-specific KAC resource]

diff --git a/src/sm/launcher/runtimes/container/instance.cpp b/src/sm/launcher/runtimes/container/instance.cpp
--- a/src/sm/launcher/runtimes/container/instance.cpp
+++ b/src/sm/launcher/runtimes/container/instance.cpp
@@ -14,6 +14,7 @@
 #include <common/utils/utils.hpp>
 
 #include "instance.hpp"
+#include "kuksatokenmount.hpp"
 #include "runtimeconfig.hpp"
 
 namespace aos::sm::launcher {
@@ -539,5 +540,36 @@ Error Instance::AddResources(const Array<oci::ResourceInfo>& resources, oci::RuntimeConfig& runtimeConfig)
 
         for (const auto& mount : resourceInfo->mMounts) {
+            if (resource.mName == "kuksa-auth-client" && mount.mDestination == "/run/aosedge/secrets/kuksa") {
+                std::vector<std::string> options;
+                for (const auto& option : mount.mOptions) {
+                    options.emplace_back(option.CStr());
+                }
+
+                auto owned = demo::BindKuksaTokenOwner(resource.mName.CStr(), mount.mDestination.CStr(),
+                    mount.mType.CStr(), mount.mSource.CStr(), options, mInstanceInfo.mUID, mInstanceInfo.mGID);
+                if (owned.state != demo::TokenMountState::Adjusted) {
+                    return AOS_ERROR_WRAP(Error(ErrorEnum::eInvalidArgument, "invalid KAC token tmpfs"));
+                }
+
+                auto instanceMount = std::make_unique<Mount>(mount);
+                instanceMount->mOptions.Clear();
+                for (const auto& option : owned.options) {
+                    StaticString<cFSMountOptionLen> nativeOption;
+                    if (auto err = nativeOption.Assign(option.c_str()); !err.IsNone()) {
+                        return AOS_ERROR_WRAP(err);
+                    }
+                    if (auto err = instanceMount->mOptions.PushBack(nativeOption); !err.IsNone()) {
+                        return AOS_ERROR_WRAP(err);
+                    }
+                }
+
+                if (auto err = AddMount(*instanceMount, runtimeConfig); !err.IsNone()) {
+                    return err;
+                }
+
+                continue;
+            }
+
             if (auto err = AddMount(mount, runtimeConfig); !err.IsNone()) {
                 return err;
             }
