+class ServiceReplacementTest : public LauncherTest, public WithParamInterface<int> {};
+
+TEST_P(ServiceReplacementTest, ReplacementPreservesTeardownFailureAndNeverStartsStaleVersion)
+{
+    const bool stopFails = GetParam() == 1;
+    const bool networkFails = GetParam() == 2;
+    const bool networkStopFails = GetParam() == 3;
+    const bool batchFails = GetParam() == 4;
+    const bool fails = GetParam() != 0;
+    const std::vector stored {CreateInstanceInfo("service-update", 0, "3.0.0", "runtime0")};
+    auto desired = stored;
+    desired[0].mVersion = "4.0.0";
+    int starts = 0;
+
+    mStorage.Init(stored);
+    EXPECT_CALL(mRuntime0, StartInstance).Times(2)
+        .WillRepeatedly(Invoke([&](const InstanceInfo& info, InstanceStatus& status) {
+            EXPECT_EQ(info.mVersion, starts++ == 0 ? String("3.0.0") : String("4.0.0"));
+            SetInstanceStatus(info, InstanceStateEnum::eActive, status);
+            return ErrorEnum::eNone;
+        }));
+    EXPECT_CALL(mRuntime0, StopInstance)
+        .WillOnce(Invoke([&](const InstanceIdent& info, InstanceStatus& status) {
+            // A runtime may return an error without updating its output status.
+            if (stopFails) {
+                return Error(ESRCH);
+            }
+            SetInstanceStatus(info, InstanceStateEnum::eInactive, status);
+            return Error(ErrorEnum::eNone);
+        }))
+        .WillRepeatedly(Invoke([](const InstanceIdent& info, InstanceStatus& status) {
+            SetInstanceStatus(info, InstanceStateEnum::eInactive, status);
+            return Error(ErrorEnum::eNone);
+        }));
+    if (networkFails) {
+        EXPECT_CALL(mNetworkManager, ReleaseInstanceNetwork).WillOnce(Return(Error(EPERM)))
+            .WillRepeatedly(Return(ErrorEnum::eNone));
+    }
+    if (networkStopFails) {
+        EXPECT_CALL(mNetworkManager, StopInstanceNetwork).WillOnce(Return(Error(EIO)))
+            .WillRepeatedly(Return(ErrorEnum::eNone));
+    }
+    EXPECT_CALL(mImageManager, RemoveUpdateItem(String("service-update"), String("3.0.0")))
+        .Times(fails ? 0 : 1).WillRepeatedly(Return(ErrorEnum::eNone));
+
+    auto err = mLauncher.Init(mAllocator, GetRuntimesArray(), mImageManager, mSender, mStorage, mOCISpec, mItemInfoProvider,
+        mCloudConnection, mNetworkManager, mInstanceIDProvider, mResourceInfoProvider);
+    ASSERT_TRUE(err.IsNone());
+    ASSERT_TRUE(mLauncher.Start().IsNone());
+    ASSERT_TRUE(mLauncher.GetInstancesStatuses(mReceivedStatuses).IsNone());
+    if (batchFails) {
+        StaticString<cIDLen> instanceID;
+        ASSERT_TRUE(mInstanceIDProvider.GetInstanceID(stored[0], instanceID).IsNone());
+        EXPECT_CALL(mNetworkManager, FlushBatch)
+            .WillOnce(Invoke([instanceID](Array<StaticString<cIDLen>>& failedIDs) {
+                failedIDs.PushBack(instanceID);
+                return ErrorEnum::eFailed;
+            }))
+            .WillRepeatedly(Return(ErrorEnum::eNone));
+    }
+    ASSERT_TRUE(mLauncher.UpdateInstances({}, Array<InstanceInfo>(desired.data(), desired.size())).IsNone());
+    ASSERT_TRUE(mSender.WaitStatuses(mReceivedStatuses, cWaitTimeout).IsNone());
+    ASSERT_EQ(mReceivedStatuses.Size(), 1);
+    EXPECT_EQ(mReceivedStatuses[0].mVersion, String(fails ? "3.0.0" : "4.0.0"));
+    EXPECT_EQ(mReceivedStatuses[0].mState, fails ? InstanceStateEnum::eFailed : InstanceStateEnum::eActive);
+    if (fails) {
+        if (batchFails) {
+            EXPECT_TRUE(mReceivedStatuses[0].mError.Is(ErrorEnum::eFailed));
+        } else {
+            EXPECT_EQ(mReceivedStatuses[0].mError.Errno(), stopFails ? ESRCH : networkFails ? EPERM : EIO);
+        }
+    }
+    auto persisted = std::make_unique<InstanceInfoArray>();
+    ASSERT_TRUE(mStorage.GetAllInstancesInfos(*persisted).IsNone());
+    ASSERT_EQ(persisted->Size(), 1);
+    EXPECT_EQ((*persisted)[0].mVersion, String(fails ? "3.0.0" : "4.0.0"));
+    if (fails) {
+        ASSERT_TRUE(Mock::VerifyAndClearExpectations(&mImageManager));
+        EXPECT_CALL(mImageManager, RemoveUpdateItem(String("service-update"), String("3.0.0")))
+            .WillOnce(Return(ErrorEnum::eNone));
+        ASSERT_TRUE(mLauncher.UpdateInstances({}, Array<InstanceInfo>(desired.data(), desired.size())).IsNone());
+        ASSERT_TRUE(mSender.WaitStatuses(mReceivedStatuses, cWaitTimeout).IsNone());
+        ASSERT_EQ(mReceivedStatuses.Size(), 1);
+        EXPECT_EQ(mReceivedStatuses[0].mVersion, String("4.0.0"));
+        EXPECT_EQ(mReceivedStatuses[0].mState, InstanceStateEnum::eActive);
+        ASSERT_TRUE(mStorage.GetAllInstancesInfos(*persisted).IsNone());
+        ASSERT_EQ(persisted->Size(), 1);
+        EXPECT_EQ((*persisted)[0].mVersion, String("4.0.0"));
+    }
+    ASSERT_TRUE(mLauncher.Stop().IsNone());
+}
+
+INSTANTIATE_TEST_SUITE_P(ServiceUpdate, ServiceReplacementTest, Values(0, 1, 2, 3, 4));
+
+class ServicePreparationRetryTest : public LauncherTest, public WithParamInterface<int> {};
+
+TEST_P(ServicePreparationRetryTest, SameDesiredServiceRetriesFailedPreparation)
+{
+    const bool configFails = GetParam() == 0;
+    const bool persistentFailure = GetParam() == 2;
+    const std::vector stored {CreateInstanceInfo("service-prepare", 0, "7.0.0", "runtime0")};
+    // Mainline adopts persisted instances at startup instead of preparing them.
+    // Exercise a new install explicitly, then repeat the identical desired state.
+
+    if (configFails) {
+        EXPECT_CALL(mItemInfoProvider, GetBlobPath)
+            .WillOnce(Return(ErrorEnum::eNotFound))
+            .WillRepeatedly(Return(ErrorEnum::eNone));
+        EXPECT_CALL(mNetworkManager, CreateInstanceNetwork).Times(1).WillOnce(Return(ErrorEnum::eNone));
+    } else {
+        EXPECT_CALL(mNetworkManager, CreateInstanceNetwork)
+            .WillOnce(Return(ErrorEnum::eFailed))
+            .WillOnce(Return(persistentFailure ? ErrorEnum::eFailed : ErrorEnum::eNone));
+    }
+
+    if (persistentFailure) {
+        EXPECT_CALL(mRuntime0, StartInstance).Times(0);
+        EXPECT_CALL(mRuntime0, StopInstance).WillOnce(Return(ErrorEnum::eNotFound));
+    } else {
+        EXPECT_CALL(mRuntime0, StartInstance)
+            .WillOnce(Invoke([](const InstanceInfo& info, InstanceStatus& status) {
+                SetInstanceStatus(info, InstanceStateEnum::eActive, status);
+                return ErrorEnum::eNone;
+            }));
+        EXPECT_CALL(mRuntime0, StopInstance).WillOnce(Return(ErrorEnum::eNone));
+    }
+
+    ASSERT_TRUE(mLauncher.Init(mAllocator, GetRuntimesArray(), mImageManager, mSender, mStorage, mOCISpec,
+        mItemInfoProvider, mCloudConnection, mNetworkManager, mInstanceIDProvider, mResourceInfoProvider).IsNone());
+    ASSERT_TRUE(mLauncher.Start().IsNone());
+    ASSERT_TRUE(mLauncher.GetInstancesStatuses(mReceivedStatuses).IsNone());
+    ASSERT_TRUE(mLauncher.UpdateInstances({}, Array<InstanceInfo>(stored.data(), stored.size())).IsNone());
+    ASSERT_TRUE(mSender.WaitStatuses(mReceivedStatuses, cWaitTimeout).IsNone());
+    ASSERT_EQ(mReceivedStatuses.Size(), 1);
+    EXPECT_EQ(mReceivedStatuses[0].mState, InstanceStateEnum::eFailed);
+
+    ASSERT_TRUE(mLauncher.UpdateInstances({}, Array<InstanceInfo>(stored.data(), stored.size())).IsNone());
+    ASSERT_TRUE(mSender.WaitStatuses(mReceivedStatuses, cWaitTimeout).IsNone());
+    ASSERT_EQ(mReceivedStatuses.Size(), 1);
+    EXPECT_EQ(mReceivedStatuses[0].mVersion, String("7.0.0"));
+    EXPECT_EQ(mReceivedStatuses[0].mState,
+        persistentFailure ? InstanceStateEnum::eFailed : InstanceStateEnum::eActive);
+    ASSERT_TRUE(mLauncher.Stop().IsNone());
+}
+
+INSTANTIATE_TEST_SUITE_P(ServicePreparation, ServicePreparationRetryTest, Values(0, 1, 2));
+
 TEST_F(LauncherTest, ParallelUpdateInstancesDoesNotInterfere)
