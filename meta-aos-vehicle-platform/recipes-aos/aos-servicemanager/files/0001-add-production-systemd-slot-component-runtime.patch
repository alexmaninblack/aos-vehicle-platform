From: Demo Solution Team <noreply@example.invalid>
Subject: [PATCH] sm: integrate production systemd-slot component runtime

Keep archive validation and the explicit VDP runtime beside the
mainline runtime types; preserve Safe Stop and durable recovery.

Upstream-Status: Pending [native regression proof; mainline migration]
Base: aos_core_cpp 9d613a46df3c7f550062e2f19ae3406c57715694

diff --git a/src/sm/imagemanager/imagehandler.cpp b/src/sm/imagemanager/imagehandler.cpp
index a825c27d..f39aed6e 100644
--- a/src/sm/imagemanager/imagehandler.cpp
+++ b/src/sm/imagemanager/imagehandler.cpp
@@ -16,6 +16,7 @@
 #include <common/utils/image.hpp>
 
 #include "imagehandler.hpp"
+#include "providerarchive.hpp"
 
 namespace aos::sm::imagemanager {
 
@@ -85,6 +86,12 @@ Error ImageHandler::UnpackLayer(const String& src, const String& dst, const Stri
             return err;
         }
 
+        if (mediaType == cLegacyProviderLayerMediaType) {
+            if (auto err = ValidateProviderArchive(src.CStr()); !err.IsNone()) {
+                return AOS_ERROR_WRAP(err);
+            }
+        }
+
         std::filesystem::create_directory(dst.CStr());
 
         if (auto err = common::utils::UnpackTarImage(src.CStr(), dst.CStr()); !err.IsNone()) {
@@ -143,7 +150,8 @@ RetWithError<StaticString<oci::cDigestLen>> ImageHandler::GetUnpackedLayerDigest
 
 Error ImageHandler::CheckMediaType(const String& mediaType) const
 {
-    if (mediaType != oci::cMediaTypeLayerTar && mediaType != oci::cMediaTypeLayerTarGZip) {
+    if (mediaType != oci::cMediaTypeLayerTar && mediaType != oci::cMediaTypeLayerTarGZip
+        && mediaType != cLegacyProviderLayerMediaType) {
         return AOS_ERROR_WRAP(Error(ErrorEnum::eNotSupported, "unsupported layer media type"));
     }
 
diff --git a/src/sm/launcher/CMakeLists.txt b/src/sm/launcher/CMakeLists.txt
index e6745532..c22bc486 100644
--- a/src/sm/launcher/CMakeLists.txt
+++ b/src/sm/launcher/CMakeLists.txt
@@ -18,6 +18,10 @@ set(SOURCES instanceidprovider.cpp runtimes.cpp)
 
 set(LIBRARIES Poco::JSON aos::core::common::tools aos::sm::utils)
 
+if(AOS_SYSTEMD_SLOT_COMPONENT_DIR)
+    list(APPEND LIBRARIES aos::sm::runtimes::systemdslotcomponent)
+endif()
+
 if(WITH_RUNTIME_CONTAINER)
     list(APPEND LIBRARIES aos::sm::runtimes::container)
 endif()
diff --git a/src/sm/launcher/runtimes.cpp b/src/sm/launcher/runtimes.cpp
index fd564ef1..d90c78fa 100644
--- a/src/sm/launcher/runtimes.cpp
+++ b/src/sm/launcher/runtimes.cpp
@@ -8,6 +8,10 @@
 
 #include "runtimes.hpp"
 
+#ifdef AOS_SYSTEMD_SLOT_COMPONENT_RUNTIME
+#include <runtime.hpp>
+#endif
+
 #ifdef WITH_RUNTIME_BOOT
 #include "runtimes/boot/boot.hpp"
 #endif
@@ -78,6 +82,16 @@ Error Runtimes::Init(const Config&                             config,
             mRuntimes.emplace_back(std::move(runtime));
         } else
 #endif
+#ifdef AOS_SYSTEMD_SLOT_COMPONENT_RUNTIME
+            if (runtimeConfig.mPlugin == cRuntimeSystemdSlotComponent) {
+            auto runtime = std::make_unique<SystemdSlotComponentRuntime>();
+            if (auto err = runtime->Init(runtimeConfig, currentNodeInfoProvider, itemInfoProvider, ociSpec,
+                    statusReceiver, systemdConn); !err.IsNone()) {
+                return AOS_ERROR_WRAP(err);
+            }
+            mRuntimes.emplace_back(std::move(runtime));
+        } else
+#endif
         {
             return AOS_ERROR_WRAP(Error(ErrorEnum::eNotSupported, "runtime is not supported"));
         }
diff --git a/src/sm/launcher/runtimes/CMakeLists.txt b/src/sm/launcher/runtimes/CMakeLists.txt
index a919d7f3..32f080a1 100644
--- a/src/sm/launcher/runtimes/CMakeLists.txt
+++ b/src/sm/launcher/runtimes/CMakeLists.txt
@@ -28,3 +28,11 @@ if(WITH_RUNTIME_ROOTFS)
 endif()
 
 add_subdirectory(utils)
+
+if(AOS_SYSTEMD_SLOT_COMPONENT_DIR)
+    if(NOT IS_ABSOLUTE "${AOS_SYSTEMD_SLOT_COMPONENT_DIR}"
+       OR NOT EXISTS "${AOS_SYSTEMD_SLOT_COMPONENT_DIR}/CMakeLists.txt")
+        message(FATAL_ERROR "AOS_SYSTEMD_SLOT_COMPONENT_DIR must be an absolute runtime source directory")
+    endif()
+    add_subdirectory("${AOS_SYSTEMD_SLOT_COMPONENT_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/systemd-slot-component")
+endif()
