From: Demo Solution Team <noreply@example.invalid>
Subject: [PATCH] cm: configure the optional idle full status interval

Carry the accepted config setting through the mainline allocator API.

Upstream-Status: Pending [native regression proof; mainline migration]
Base: aos_core_cpp 9d613a46df3c7f550062e2f19ae3406c57715694

diff --git a/src/cm/app/aoscore.cpp b/src/cm/app/aoscore.cpp
index 960d6875..ccaa2707 100644
--- a/src/cm/app/aoscore.cpp
+++ b/src/cm/app/aoscore.cpp
@@ -111,7 +111,7 @@ void AosCore::Init(const std::string& configFile)
         mCommunication);
     AOS_ERROR_CHECK_AND_THROW(err, "can't initialize launcher");
 
-    err = mUpdateManager.Init(mAllocator, {mConfig.mUnitStatusSendTimeout}, mIAMClient, mIAMClient, mUnitConfig,
+    err = mUpdateManager.Init(mAllocator, {mConfig.mUnitStatusSendTimeout, mConfig.mIdleFullStatusInterval}, mIAMClient, mIAMClient, mUnitConfig,
         mNodeInfoProvider, mImageManager, mLauncher, mCommunication, mCommunication, mDatabase);
     AOS_ERROR_CHECK_AND_THROW(err, "can't initialize update manager");
 
diff --git a/src/cm/config/config.cpp b/src/cm/config/config.cpp
index a5a89c19..5b2dd524 100644
--- a/src/cm/config/config.cpp
+++ b/src/cm/config/config.cpp
@@ -172,6 +172,13 @@ Error ParseConfig(const std::string& filename, Config& config)
             object.GetValue<std::string>("unitStatusSendTimeout", cDefaultUnitStatusSendTimeout));
         AOS_ERROR_CHECK_AND_THROW(err, "error parsing unitStatusSendTimeout tag");
 
+        Tie(config.mIdleFullStatusInterval, err) = common::utils::ParseDuration(
+            object.GetValue<std::string>("idleFullStatusInterval", "0s"));
+        AOS_ERROR_CHECK_AND_THROW(err, "error parsing idleFullStatusInterval tag");
+        if (config.mIdleFullStatusInterval < Duration {}) {
+            return ErrorEnum::eInvalidArgument;
+        }
+
         Tie(config.mCloudResponseWaitTimeout, err) = common::utils::ParseDuration(
             object.GetValue<std::string>("cloudResponseWaitTimeout", cDefaultCloudResponseWaitTimeout));
         AOS_ERROR_CHECK_AND_THROW(err, "error parsing cloudResponseWaitTimeout tag");
diff --git a/src/cm/config/config.hpp b/src/cm/config/config.hpp
index f21f453d..88d4cb9b 100644
--- a/src/cm/config/config.hpp
+++ b/src/cm/config/config.hpp
@@ -59,6 +59,7 @@ struct Config {
     std::string               mWorkingDir;
     std::string               mUnitConfigFile;
     Duration                  mUnitStatusSendTimeout;
+    Duration                  mIdleFullStatusInterval {};
     Duration                  mCloudResponseWaitTimeout;
 };
 
diff --git a/src/cm/config/tests/config.cpp b/src/cm/config/tests/config.cpp
index e21457b9..eb0e180d 100644
--- a/src/cm/config/tests/config.cpp
+++ b/src/cm/config/tests/config.cpp
@@ -36,6 +36,7 @@ constexpr auto cFullTestConfigJSON = R"({
     "workingDir": "workingDir",
     "unitConfigFile": "/var/aos/aos_unit.cfg",
     "cloudResponseWaitTimeout": "3d",
+    "idleFullStatusInterval": "60s",
     "monitoring": {
         "sendPeriod": "5m"
     },
@@ -129,6 +130,7 @@ TEST_F(CMConfigTest, ParseFullConfig)
     EXPECT_EQ(config.mCertStorage, "/var/aos/crypt/cm/");
 
     EXPECT_EQ(config.mCloudResponseWaitTimeout, aos::Time::cDay * 3);
+    EXPECT_EQ(config.mIdleFullStatusInterval, aos::Time::cSeconds * 60);
 
     EXPECT_EQ(config.mMonitoring.mSendPeriod, aos::Time::cMinutes * 5);
     EXPECT_EQ(config.mNodeInfoProvider.mSMConnectionTimeout, aos::Time::cMinutes * 10);
@@ -173,6 +175,7 @@ TEST_F(CMConfigTest, ParseMinimalConfigWithDefaults)
     EXPECT_EQ(config.mUnitConfigFile, (std::filesystem::path("workingDir") / "aos_unit.cfg").string());
 
     EXPECT_EQ(config.mUnitStatusSendTimeout, aos::Time::cSeconds * 10);
+    EXPECT_EQ(config.mIdleFullStatusInterval, aos::Duration {});
     EXPECT_EQ(config.mCloudResponseWaitTimeout, aos::Time::cSeconds * 10);
 
     EXPECT_EQ(config.mMonitoring.mSendPeriod, aos::Time::cMinutes * 1);
