+#include <memory>
+#include <tuple>
+
+#include <gtest/gtest.h>
+#include <core/cm/launcher/instancemanager.hpp>
+#include <core/common/tests/utils/log.hpp>
+
+#include "stubs/imagestorestub.hpp"
+#include "stubs/storagestatestub.hpp"
+#include "stubs/storagestub.hpp"
+
+namespace aos::cm::launcher {
+namespace {
+
+class RetirementStorage : public StorageStub {
+public:
+    std::string failVersion;
+    Error RemoveInstance(const InstanceIdent& id, const String& version) override
+    {
+        if (failVersion == version.CStr()) {
+            return ErrorEnum::eFailed;
+        }
+        return StorageStub::RemoveInstance(id, version);
+    }
+};
+
+class RetirementState : public storagestate::StorageStateStub {
+public:
+    bool failRemove = false;
+    Error Remove(const InstanceIdent& id) override
+    {
+        if (failRemove) {
+            return ErrorEnum::eFailed;
+        }
+        return StorageStateStub::Remove(id);
+    }
+};
+
+class CMStorageRetention : public testing::Test {
+protected:
+    void SetUp() override
+    {
+        tests::utils::InitLog();
+        Config config;
+        config.mInstanceTTL = Time::cDay;
+        config.mNodesConnectionTimeout = Time::cMinutes;
+        ASSERT_TRUE(manager->Init(config, images, state, images,
+            [](size_t) { return true; }, [](size_t) { return true; }, rows).IsNone());
+    }
+    void TearDown() override { EXPECT_TRUE(manager->Stop().IsNone()); }
+
+    InstanceInfo Add(const InstanceIdent& id, const char* version, InstanceState status,
+        bool expired, bool imagePresent = true)
+    {
+        oci::ItemConfig item;
+        oci::ImageConfig image;
+        if (imagePresent) {
+            images.AddItem(id.mItemID, "image", item, image, version);
+        }
+        InstanceInfo info;
+        info.mInstanceIdent = id;
+        info.mVersion = version;
+        info.mManifestDigest = images.GetManifestDigest(id.mItemID, "image");
+        info.mState = status;
+        info.mTimestamp = expired ? Time::Now().Add(-25 * Time::cHours) : Time::Now();
+        info.mUID = uid++;
+        info.mGID = id.mItemID == "service-b" ? 5001 : 5000;
+        EXPECT_TRUE(rows.AddInstance(info).IsNone());
+        return info;
+    }
+    void Restart()
+    {
+        ASSERT_TRUE(manager->Stop().IsNone());
+        ASSERT_TRUE(manager->Start().IsNone());
+    }
+
+    const InstanceIdent id {"service-a", "subject-a", 0, UpdateItemTypeEnum::eService};
+    RetirementStorage rows;
+    RetirementState state;
+    imagemanager::ImageStoreStub images;
+    std::unique_ptr<InstanceManager> manager = std::make_unique<InstanceManager>();
+    uint32_t uid = 5000;
+};
+
+class CMStorageSurvivor : public CMStorageRetention,
+    public testing::WithParamInterface<std::tuple<bool, int, int>> { };
+
+TEST_P(CMStorageSurvivor, OldVersionCleanupPreservesSharedData)
+{
+    const auto [expire, survivorKind, oldCount] = GetParam();
+    const InstanceState survivorStates[] {
+        InstanceStateEnum::eActive, InstanceStateEnum::eCached, InstanceStateEnum::eDisabled};
+    auto current = Add(id, "4.0.0", survivorStates[survivorKind], false);
+    for (int index = 1; index <= oldCount; ++index) {
+        const auto version = std::to_string(index) + ".0.0";
+        Add(id, version.c_str(), InstanceStateEnum::eCached, expire, expire);
+    }
+    ASSERT_TRUE(manager->Start().IsNone());
+    EXPECT_TRUE(rows.HasInstance(id, "4.0.0"));
+    for (int index = 1; index <= oldCount; ++index) {
+        const auto version = std::to_string(index) + ".0.0";
+        EXPECT_FALSE(rows.HasInstance(id, version.c_str()));
+    }
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+    Restart();
+    EXPECT_TRUE(rows.HasInstance(id, "4.0.0"));
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+
+    // Once the final owner actually expires, cleanup must not leak its data.
+    current.mState = InstanceStateEnum::eCached;
+    current.mTimestamp = Time::Now().Add(-25 * Time::cHours);
+    ASSERT_TRUE(rows.UpdateInstance(current).IsNone());
+    Restart();
+    EXPECT_FALSE(rows.HasInstance(id, "4.0.0"));
+    ASSERT_EQ(state.GetRemovedInstances().size(), 1U);
+    EXPECT_TRUE(state.GetRemovedInstances().front() == id);
+    Restart();
+    EXPECT_EQ(state.GetRemovedInstances().size(), 1U);
+}
+
+INSTANTIATE_TEST_SUITE_P(MissingImageAndExpiry, CMStorageSurvivor,
+    testing::Combine(testing::Bool(), testing::Values(0, 1, 2), testing::Values(1, 3)));
+
+class CMStorageIsolation : public CMStorageRetention,
+    public testing::WithParamInterface<std::tuple<bool, int>> { };
+
+TEST_P(CMStorageIsolation, AnotherIdentityDoesNotRetainRetiredStorage)
+{
+    const auto [expire, difference] = GetParam();
+    auto other = id;
+    if (difference == 0) other.mSubjectID = "subject-b";
+    if (difference == 1) other.mInstance = 1;
+    if (difference == 2) other.mItemID = "service-b";
+    if (difference == 3) other.mType = UpdateItemTypeEnum::eComponent;
+    Add(other, "2.0.0", InstanceStateEnum::eActive, false);
+    Add(id, "1.0.0", InstanceStateEnum::eCached, expire, expire);
+    ASSERT_TRUE(manager->Start().IsNone());
+    EXPECT_TRUE(rows.HasInstance(other, "2.0.0"));
+    EXPECT_FALSE(rows.HasInstance(id, "1.0.0"));
+    ASSERT_EQ(state.GetRemovedInstances().size(), 1U);
+    EXPECT_TRUE(state.GetRemovedInstances().front() == id);
+}
+
+INSTANTIATE_TEST_SUITE_P(MissingImageAndExpiry, CMStorageIsolation,
+    testing::Combine(testing::Bool(), testing::Values(0, 1, 2, 3)));
+
+TEST_F(CMStorageRetention, MultipleRetiredOwnersRemoveStorageOnlyOnce)
+{
+    Add(id, "1.0.0", InstanceStateEnum::eCached, true);
+    Add(id, "2.0.0", InstanceStateEnum::eCached, true);
+    Add(id, "3.0.0", InstanceStateEnum::eCached, true);
+    ASSERT_TRUE(manager->Start().IsNone());
+    EXPECT_EQ(manager->GetCachedInstances().Size(), 0U);
+    ASSERT_EQ(state.GetRemovedInstances().size(), 1U);
+    EXPECT_TRUE(state.GetRemovedInstances().front() == id);
+}
+
+TEST_F(CMStorageRetention, InvalidActiveOldVersionPreservesCachedOwner)
+{
+    Add(id, "1.0.0", InstanceStateEnum::eActive, false, false);
+    Add(id, "2.0.0", InstanceStateEnum::eCached, false);
+    ASSERT_TRUE(manager->Start().IsNone());
+    EXPECT_FALSE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_TRUE(rows.HasInstance(id, "2.0.0"));
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+}
+
+TEST_F(CMStorageRetention, FailedRowRetirementRemainsOwnerForOtherCleanup)
+{
+    Add(id, "1.0.0", InstanceStateEnum::eCached, true);
+    Add(id, "2.0.0", InstanceStateEnum::eCached, true);
+    rows.failVersion = "1.0.0";
+    EXPECT_FALSE(manager->Start().IsNone());
+    EXPECT_TRUE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_FALSE(rows.HasInstance(id, "2.0.0"));
+    EXPECT_EQ(manager->GetCachedInstances().Size(), 1U);
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+    rows.failVersion.clear();
+    Restart();
+    EXPECT_FALSE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_EQ(state.GetRemovedInstances().size(), 1U);
+}
+
+TEST_F(CMStorageRetention, StorageRemovalFailureKeepsFinalOwnerRetryable)
+{
+    Add(id, "1.0.0", InstanceStateEnum::eCached, true);
+    state.failRemove = true;
+    EXPECT_FALSE(manager->Start().IsNone());
+    EXPECT_TRUE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_EQ(manager->GetCachedInstances().Size(), 1U);
+    state.failRemove = false;
+    Restart();
+    EXPECT_FALSE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_EQ(state.GetRemovedInstances().size(), 1U);
+}
+
+TEST_F(CMStorageRetention, FailedInvalidActiveRetirementProtectsCachedOwner)
+{
+    Add(id, "1.0.0", InstanceStateEnum::eActive, false, false);
+    Add(id, "2.0.0", InstanceStateEnum::eCached, false, false);
+    rows.failVersion = "1.0.0";
+    EXPECT_FALSE(manager->Start().IsNone());
+    EXPECT_TRUE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_FALSE(rows.HasInstance(id, "2.0.0"));
+    EXPECT_EQ(manager->GetActiveInstances().Size(), 1U);
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+    rows.failVersion.clear();
+    Restart();
+    EXPECT_FALSE(rows.HasInstance(id, "1.0.0"));
+    EXPECT_EQ(state.GetRemovedInstances().size(), 1U);
+}
+
+TEST_F(CMStorageRetention, EmptyStartupIsIdempotent)
+{
+    ASSERT_TRUE(manager->Start().IsNone());
+    Restart();
+    EXPECT_TRUE(state.GetRemovedInstances().empty());
+}
+
+} // namespace
+} // namespace aos::cm::launcher

