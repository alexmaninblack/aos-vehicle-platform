+class IdleRefreshTest : public UpdateManagerTest {
+protected:
+    Duration IdleRefreshInterval() const override { return 100 * Time::cMilliseconds; }
+};
+
+TEST_F(UpdateManagerTest, IdleRefreshDisabledByDefault)
+{
+    mConnectionListener->OnConnect();
+    ASSERT_TRUE(mSenderStub.WaitForCount(1, std::chrono::milliseconds(1000)));
+    EXPECT_FALSE(mSenderStub.WaitForCount(2, std::chrono::milliseconds(250)));
+}
+
+TEST_F(IdleRefreshTest, SendsFreshFullSnapshotsWithoutDesiredStatus)
+{
+    EXPECT_CALL(mImageManagerMock, DownloadUpdateItems(_, _, _, _)).Times(0);
+    EXPECT_CALL(mImageManagerMock, InstallUpdateItems(_, _)).Times(0);
+    mConnectionListener->OnConnect();
+    ASSERT_TRUE(mSenderStub.WaitForCount(3, std::chrono::milliseconds(1500)));
+    EXPECT_TRUE(mSenderStub.IsFullSnapshot());
+}
+
+TEST_F(IdleRefreshTest, DisconnectSuppressesRefreshAndReconnectResumes)
+{
+    mConnectionListener->OnConnect();
+    ASSERT_TRUE(mSenderStub.WaitForCount(2, std::chrono::milliseconds(1500)));
+    mConnectionListener->OnDisconnect();
+    // Allow a full report already in progress to return, then require silence.
+    std::this_thread::sleep_for(std::chrono::milliseconds(150));
+    auto count = mSenderStub.SendCount();
+    EXPECT_FALSE(mSenderStub.WaitForCount(count + 1, std::chrono::milliseconds(250)));
+    mConnectionListener->OnConnect();
+    EXPECT_TRUE(mSenderStub.WaitForCount(count + 2, std::chrono::milliseconds(1500)));
+    EXPECT_TRUE(mSenderStub.IsFullSnapshot());
+}
+
+TEST_F(IdleRefreshTest, CollectionFailureReleasesSnapshotForLaterRefresh)
+{
+    EXPECT_CALL(mUnitConfigMock, GetUnitConfigStatus(_))
+        .WillOnce(Return(ErrorEnum::eFailed)).WillRepeatedly(Return(ErrorEnum::eNone));
+    mConnectionListener->OnConnect();
+    ASSERT_TRUE(mSenderStub.WaitForCount(2, std::chrono::milliseconds(1500)));
+    EXPECT_TRUE(mSenderStub.IsFullSnapshot());
+}
+
