From: AosEdge Demo Integration
Subject: [PATCH] Reconcile persisted generated components before cold-start resend

Base: aos_core_lib_cpp 5560291ba6914e36a5b841ade4d8fc54134a9e91
Upstream-Status: Pending

A desired per-runtime component can survive in run-request storage while its
instance row is missing after unavailable runtime discovery. Restore that plan
once on startup before SM status reconciliation can stop the retained component.
Do not manufacture intent from SM reports. Explicit removal and foreign/stale
reports remain subject to normal reconciliation. Six native regressions cover
retained/absent SM state, removal, version/subject mismatch and repeated startup.

diff --git a/src/core/cm/launcher/launcher.cpp b/src/core/cm/launcher/launcher.cpp
index 8e8da7099..910881cea 100644
--- a/src/core/cm/launcher/launcher.cpp
+++ b/src/core/cm/launcher/launcher.cpp
@@ -530,7 +530,10 @@ void Launcher::ProcessNotScheduledInstances()
     bool hasNotScheduledInstance = mInstanceManager.GetActiveInstances().ContainsIf(
         [](const SharedPtr<Instance>& instance) { return instance->GetInfo().mNodeID.IsEmpty(); });
 
-    mForceRebalance = hasNotScheduledInstance;
+    // Generated component rows can be absent after a boot with no usable SM
+    // runtime snapshot. Rebuild the persisted desired plan once at startup,
+    // before comparing it with SM's recovered instances and issuing stops.
+    mForceRebalance = hasNotScheduledInstance || mRunRequestsLoader.HasGeneratedRequests();
     mProcessUpdatesCondVar.NotifyAll();
 }
 
diff --git a/src/core/cm/launcher/runrequestsloader.cpp b/src/core/cm/launcher/runrequestsloader.cpp
index 49752ac24..11f6fec7b 100644
--- a/src/core/cm/launcher/runrequestsloader.cpp
+++ b/src/core/cm/launcher/runrequestsloader.cpp
@@ -39,6 +39,13 @@ Error RunRequestsLoader::Load()
     return mStorage->LoadRunRequests(mRunRequests);
 }
 
+bool RunRequestsLoader::HasGeneratedRequests() const
+{
+    return mRunRequests.ContainsIf([](const RunInstanceRequest& request) {
+        return request.mNumInstances == 0 && request.mUpdateItemType == UpdateItemTypeEnum::eComponent;
+    });
+}
+
 void RunRequestsLoader::CreateInstances(const Array<Node>& nodes, Array<SharedPtr<Instance>>& instances)
