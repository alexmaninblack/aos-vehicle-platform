+class CMIdentityRetention : public CMStorageRetention {
+protected:
+    void SetUp() override
+    {
+        CMStorageRetention::SetUp();
+        ASSERT_TRUE(uidPool.Init([](size_t) { return true; }).IsNone());
+        ASSERT_TRUE(gidPool.Init([](size_t) { return true; }).IsNone());
+        storageState.Init(allocator, state);
+        imageInfo.Init(allocator, images, images);
+    }
+    std::unique_ptr<ServiceInstance> Instance(const InstanceIdent& identity,
+        const char* version, uint32_t requestedUID = 0)
+    {
+        InstanceInfo info;
+        info.mInstanceIdent = identity;
+        info.mVersion = version;
+        info.mUID = requestedUID;
+        return std::make_unique<ServiceInstance>(allocator, info, uidPool, gidPool, rows, storageState, imageInfo);
+    }
+    UIDPool uidPool;
+    GIDPool gidPool;
+    StorageState storageState;
+    ImageInfoProvider imageInfo;
+};
+
+TEST_F(CMIdentityRetention, ThreeVersionsKeepUidUntilFinalSuccessfulRetirement)
+{
+    auto v1 = Instance(id, "1.0.0");
+    auto v2 = Instance(id, "2.0.0");
+    auto v3 = Instance(id, "3.0.0");
+    ASSERT_TRUE(v1->Init().IsNone());
+    ASSERT_TRUE(v2->Init().IsNone());
+    ASSERT_TRUE(v3->Init().IsNone());
+    const auto originalUID = v1->GetInfo().mUID;
+    EXPECT_EQ(v2->GetInfo().mUID, originalUID);
+    EXPECT_EQ(v3->GetInfo().mUID, originalUID);
+    rows.failVersion = "1.0.0";
+    EXPECT_FALSE(v1->Remove(false).IsNone());
+    EXPECT_FALSE(v1->Remove(false).IsNone());
+    ASSERT_TRUE(v2->Remove(false).IsNone());
+    auto other = id;
+    other.mSubjectID = "another-subject";
+    auto foreign = Instance(other, "1.0.0");
+    ASSERT_TRUE(foreign->Init().IsNone());
+    EXPECT_NE(foreign->GetInfo().mUID, originalUID);
+    rows.failVersion.clear();
+    ASSERT_TRUE(v1->Remove(false).IsNone());
+    auto v4 = Instance(id, "4.0.0");
+    ASSERT_TRUE(v4->Init().IsNone());
+    EXPECT_EQ(v4->GetInfo().mUID, originalUID);
+    ASSERT_TRUE(v3->Remove(false).IsNone());
+    ASSERT_TRUE(v4->Remove(true).IsNone());
+    ASSERT_EQ(state.GetRemovedInstances().size(), 1U);
+}
+
+TEST_F(CMIdentityRetention, RejectedLegacyUidMustNotReleaseSurvivorReference)
+{
+    auto owner = Instance(id, "3.0.0", 5000);
+    ASSERT_TRUE(owner->Init().IsNone());
+    auto rejected = Instance(id, "1.0.0", 5001);
+    ASSERT_FALSE(rejected->Init().IsNone());
+    ASSERT_TRUE(rejected->Remove(false).IsNone());
+    auto other = id;
+    other.mSubjectID = "another-subject";
+    auto foreign = Instance(other, "1.0.0");
+    ASSERT_TRUE(foreign->Init().IsNone());
+    EXPECT_NE(foreign->GetInfo().mUID, owner->GetInfo().mUID);
+}
