From: AosEdge SDV Demo <noreply@example.invalid>
Subject: [PATCH] cm: preserve pending rebalance when processing subjects

An unchanged subject list must not overwrite a pending startup rebalance.
Otherwise the first SM snapshot can trigger a stop for an already running
instance before its persisted run request has been scheduled. Preserve both
independent triggers. Exercise this order in the stored-unscheduled fixture.

Upstream-Status: Pending

diff --git a/src/core/cm/launcher/launcher.cpp b/src/core/cm/launcher/launcher.cpp
index c1ed01a8..78c6e3fe 100644
--- a/src/core/cm/launcher/launcher.cpp
+++ b/src/core/cm/launcher/launcher.cpp
@@ -441,7 +441,9 @@ void Launcher::ProcessUpdate()
         bool  doRebalance = mForceRebalance;
 
         if (mNewSubjects.HasValue()) {
-            Tie(doRebalance, err) = mInstanceManager.SetSubjects(mNewSubjects.GetValue());
+            bool subjectsChanged = false;
+            Tie(subjectsChanged, err) = mInstanceManager.SetSubjects(mNewSubjects.GetValue());
+            doRebalance = doRebalance || subjectsChanged;
             if (!err.IsNone()) {
                 LOG_ERR() << "Failed to set subjects" << Log::Field(AOS_ERROR_WRAP(err));
             }
diff --git a/src/core/cm/launcher/tests/launcher.cpp b/src/core/cm/launcher/tests/launcher.cpp
index a70fa4e9..b4b73457 100644
--- a/src/core/cm/launcher/tests/launcher.cpp
+++ b/src/core/cm/launcher/tests/launcher.cpp
@@ -2394,10 +2394,21 @@ TEST_F(CMLauncherTest, RebalancingWithStoredNotScheduledInstances)
     InstanceStatusListenerStub instanceStatusListener;
     mLauncher.SubscribeListener(instanceStatusListener);
 
+    EXPECT_CALL(mInstanceRunner, OnRunRequest()).WillRepeatedly([this]() {
+        for (const auto& [node, request] : mInstanceRunner.GetRunRequests()) {
+            EXPECT_TRUE(request.mStopInstances.empty()) << "unexpected startup stop: " << node;
+        }
+    });
     ASSERT_TRUE(mLauncher.Start().IsNone());
 
     mInstanceRunner.SendInitialStatuses(cNodeIDLocalSM);
-    mInstanceRunner.SendInitialStatuses(cNodeIDRemoteSM1);
+    // SM may already run an instance whose stored CM scheduling was incomplete.
+    // Startup reconciliation must restore the plan before sending a stop request.
+    std::vector<InstanceStatus> running = {CreateInstanceStatus(
+        CreateInstanceIdent(cService2, cSubject1, 0), cNodeIDRemoteSM1, cRunnerRunc,
+        aos::InstanceStateEnum::eActive, ErrorEnum::eNone, "", false, digest2.CStr())};
+    static_cast<InstanceStatusReceiverItf&>(mLauncher).OnNodeInstancesStatusesReceived(cNodeIDRemoteSM1,
+        Array<InstanceStatus>(running.data(), running.size()));
 
     // Wait until initial statuses are processed and rebalance is completed.
     ASSERT_TRUE(instanceStatusListener.WaitForNotifyCount(3, 2s));
