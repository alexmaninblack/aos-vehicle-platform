Subject: [PATCH] smcontroller: serialize writes to the shared gRPC stream

Upstream-Status: Backport [https://github.com/AosEdge/aos_core_cpp/commit/6e0b1980e71ea6ee9979292a8aa336574d317f09]

Backport unchanged onto aos_core_cpp 9eecb80c4994937b5c8cbe0464970f81e8ad4c2d.
The synchronous request writer and Cloud-status writer must share one write mutex.

diff --git a/src/cm/smcontroller/smhandler.cpp b/src/cm/smcontroller/smhandler.cpp
index 690e97a..9a9a886 100644
--- a/src/cm/smcontroller/smhandler.cpp
+++ b/src/cm/smcontroller/smhandler.cpp
@@ -44,7 +44,7 @@ void SMHandler::Start()
 
     mStopProcessing = false;
 
-    mSyncMessageSender.Init(mStream, cResponseTime);
+    mSyncMessageSender.Init(mStream, mWriteMutex, cResponseTime);
     mSyncMessageSender.RegisterResponseHandler(
         [](const servicemanager::v5::SMOutgoingMessages& msg) { return msg.has_node_config_status(); },
         [](const servicemanager::v5::SMOutgoingMessages& src, servicemanager::v5::SMOutgoingMessages& dst) {
@@ -287,7 +287,7 @@ void SMHandler::ProcessMessages()
 
 Error SMHandler::SendMessage(const servicemanager::v5::SMIncomingMessages& message)
 {
-    std::lock_guard lock {mMutex};
+    std::lock_guard lock {mWriteMutex};
 
     if (!mStream->Write(message)) {
         return AOS_ERROR_WRAP(Error(ErrorEnum::eFailed, "failed to send message"));
diff --git a/src/cm/smcontroller/smhandler.hpp b/src/cm/smcontroller/smhandler.hpp
index 0f05451..fc36c8d 100644
--- a/src/cm/smcontroller/smhandler.hpp
+++ b/src/cm/smcontroller/smhandler.hpp
@@ -209,6 +209,7 @@ private:
