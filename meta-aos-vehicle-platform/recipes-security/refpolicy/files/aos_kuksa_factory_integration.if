## <summary>Interfaces for fixed KUKSA Factory credential lifecycle.</summary>

########################################
## <summary>Read the dedicated KUKSA token PIN.</summary>
## <param name="domain"><summary>Credential consumer domain.</summary></param>
#
interface(`aos_kuksa_pin_read',`
    gen_require(`
        type aos_kuksa_pin_t;
        type aos_var_run_t;
    ')

    read_files_pattern($1, aos_var_run_t, aos_kuksa_pin_t)
')
