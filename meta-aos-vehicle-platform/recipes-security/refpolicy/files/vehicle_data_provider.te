policy_module(vehicle_data_provider, 1.0.1)

type vehicle_data_provider_t;
type vehicle_data_provider_exec_t;
init_daemon_domain(vehicle_data_provider_t, vehicle_data_provider_exec_t)

type vehicle_data_provider_store_t;
files_type(vehicle_data_provider_store_t)

type vehicle_data_provider_store_prepare_t;
type vehicle_data_provider_store_prepare_exec_t;
init_daemon_domain(vehicle_data_provider_store_prepare_t, vehicle_data_provider_store_prepare_exec_t)

type vehicle_data_provider_store_admin_t;
type vehicle_data_provider_store_admin_exec_t;
init_daemon_domain(vehicle_data_provider_store_admin_t, vehicle_data_provider_store_admin_exec_t)

type vehicle_data_provider_store_runtime_t;
files_runtime_file(vehicle_data_provider_store_runtime_t)

type vehicle_data_provider_unit_t;
init_unit_file(vehicle_data_provider_unit_t)

allow vehicle_data_provider_t self:tcp_socket create_stream_socket_perms;
# The bounded launcher receives its non-root identity from systemd and verifies
# that all Linux capability sets are empty. SELinux treats that capget(2)
# inspection separately from using a capability.
allow vehicle_data_provider_t self:process getcap;
allow vehicle_data_provider_t self:fifo_file rw_fifo_file_perms;
allow vehicle_data_provider_t vehicle_data_provider_store_t:dir list_dir_perms;
allow vehicle_data_provider_t vehicle_data_provider_store_t:file { execute execute_no_trans map };
allow vehicle_data_provider_t vehicle_data_provider_store_t:lnk_file read_lnk_file_perms;
read_files_pattern(vehicle_data_provider_t, vehicle_data_provider_store_t, vehicle_data_provider_store_t)

corenet_tcp_connect_all_ports(vehicle_data_provider_t)
corecmd_exec_bin(vehicle_data_provider_t)
corecmd_exec_shell(vehicle_data_provider_t)
dev_read_urand(vehicle_data_provider_t)
files_read_etc_files(vehicle_data_provider_t)
init_dgram_send(vehicle_data_provider_t)
init_read_runtime_files(vehicle_data_provider_t)
init_rw_script_stream_sockets(vehicle_data_provider_t)
files_search_runtime(vehicle_data_provider_t)
logging_send_syslog_msg(vehicle_data_provider_t)
miscfiles_read_generic_certs(vehicle_data_provider_t)
miscfiles_read_localization(vehicle_data_provider_t)
sysnet_dns_name_resolve(vehicle_data_provider_t)

gen_require(`
    type aos_t;
    type aos_var_run_t;
    type initrc_runtime_t;
    type loop_control_device_t;
    type mount_t;
    type node_t;
    type proc_t;
    type sysfs_t;
    type sysctl_vm_t;
    type systemd_modules_load_t;
    class service { start stop status reload };
')

init_rw_script_stream_sockets(systemd_modules_load_t)
allow vehicle_data_provider_t aos_var_run_t:dir search;
# systemd copies LoadCredential payloads into a read-only, unit-private mount.
# The pinned systemd/refpolicy combination labels both that directory and its
# regular files initrc_runtime_t.  Keep this grant deliberately read-only;
# systemd's mount namespace and DAC restrictions provide the path boundary.
allow vehicle_data_provider_t initrc_runtime_t:dir { getattr search };
allow vehicle_data_provider_t initrc_runtime_t:file { getattr open read };

# Optional library probes remain denied. Installed grpcio1.75/CPython3.12
# transport and negative TLS tests pass with these exact syscalls returning
# EACCES. Do not grant scheduling changes, host CPU data or listening sockets.
# The ioctl exception is only CPython's isatty(TCGETS), never all ioctls.
# Evidence: docs/vdp-security-closure-2026-09-24.md.
dontaudit vehicle_data_provider_t self:process getsched;
dontaudit vehicle_data_provider_t sysfs_t:file read;
dontaudit vehicle_data_provider_t proc_t:file read;
dontaudit vehicle_data_provider_t node_t:tcp_socket node_bind;
dontauditxperm vehicle_data_provider_t initrc_runtime_t:file ioctl 0x5401;
# Non-strict Path.resolve parent inspection and glibc2.39's optional
# check_may_shrink_heap query. Neither requires new directory/file access.
dontaudit vehicle_data_provider_t aos_var_run_t:dir getattr;
dontaudit vehicle_data_provider_t sysctl_vm_t:dir search;

# This domain can only be entered through the fixed-path loop helper. The
# helper itself accepts no backing path and validates the immutable 512 MiB
# store contract before issuing any loop ioctl.
allow vehicle_data_provider_store_admin_t self:capability sys_admin;
allow vehicle_data_provider_store_admin_t aos_var_run_t:dir search;
allow vehicle_data_provider_store_admin_t aos_var_run_t:file { getattr ioctl lock open read write };
allow vehicle_data_provider_store_admin_t aos_var_run_t:filesystem getattr;
init_rw_script_stream_sockets(vehicle_data_provider_store_admin_t)
files_search_runtime(vehicle_data_provider_store_admin_t)
manage_lnk_files_pattern(vehicle_data_provider_store_admin_t, vehicle_data_provider_store_runtime_t, vehicle_data_provider_store_runtime_t)
dev_rw_loop_control(vehicle_data_provider_store_admin_t)
storage_raw_rw_fixed_disk(vehicle_data_provider_store_admin_t)

# The immutable preparation script accepts no path or size overrides. It has
# no capabilities, executes filesystem tools without entering the generic
# fsadm_t domain, and is write-confined further by its systemd mount namespace.
corecmd_exec_bin(vehicle_data_provider_store_prepare_t)
corecmd_exec_shell(vehicle_data_provider_store_prepare_t)
files_read_etc_files(vehicle_data_provider_store_prepare_t)
fstools_exec(vehicle_data_provider_store_prepare_t)
init_rw_script_stream_sockets(vehicle_data_provider_store_prepare_t)
kernel_read_system_state(vehicle_data_provider_store_prepare_t)
allow vehicle_data_provider_store_prepare_t self:fifo_file rw_fifo_file_perms;
allow vehicle_data_provider_store_prepare_t aos_var_run_t:filesystem getattr;
allow vehicle_data_provider_store_prepare_t loop_control_device_t:chr_file getattr;
allow vehicle_data_provider_store_prepare_t sysfs_t:dir read;
allow vehicle_data_provider_store_prepare_t sysfs_t:file read;
allow vehicle_data_provider_store_prepare_t sysfs_t:lnk_file read;
manage_dirs_pattern(vehicle_data_provider_store_prepare_t, aos_var_run_t, aos_var_run_t)
manage_files_pattern(vehicle_data_provider_store_prepare_t, aos_var_run_t, aos_var_run_t)
read_lnk_files_pattern(vehicle_data_provider_store_prepare_t, aos_var_run_t, aos_var_run_t)
storage_raw_read_fixed_disk(vehicle_data_provider_store_prepare_t)

allow mount_t vehicle_data_provider_store_runtime_t:dir search;
allow mount_t vehicle_data_provider_store_runtime_t:lnk_file read_lnk_file_perms;
allow mount_t vehicle_data_provider_store_t:filesystem relabelfrom;

manage_dirs_pattern(aos_t, vehicle_data_provider_store_t, vehicle_data_provider_store_t)
manage_files_pattern(aos_t, vehicle_data_provider_store_t, vehicle_data_provider_store_t)
manage_lnk_files_pattern(aos_t, vehicle_data_provider_store_t, vehicle_data_provider_store_t)
allow aos_t vehicle_data_provider_unit_t:service { start stop status reload };
