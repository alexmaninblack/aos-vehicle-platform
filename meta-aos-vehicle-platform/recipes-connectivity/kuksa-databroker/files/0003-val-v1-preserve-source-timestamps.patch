+#[cfg(test)]
+mod source_timestamp_tests {
+    use super::*;
+    use std::time::{Duration, UNIX_EPOCH};
+
+    fn values() -> Vec<broker::DataValue> {
+        use broker::DataValue::*;
+        vec![Bool(true), String("test".into()), Int32(-3), Int64(-4), Uint32(3),
+             Uint64(4), Float(1.25), Double(2.5), BoolArray(vec![true, false]),
+             StringArray(vec!["test".into()]), Int32Array(vec![-3]), Int64Array(vec![-4]),
+             Uint32Array(vec![3]), Uint64Array(vec![4]), FloatArray(vec![1.25]),
+             DoubleArray(vec![2.5])]
+    }
+
+    #[test]
+    fn source_timestamp_preserves_all_values_and_nanoseconds() {
+        let source = UNIX_EPOCH + Duration::new(1_700_000_000, 123_456_789);
+        let receipt = source + Duration::from_secs(10);
+        for value in values() {
+            let expected_value = Option::<proto::Datapoint>::from(value.clone()).unwrap().value;
+            let result = Option::<proto::Datapoint>::from(broker::Datapoint {
+                ts: receipt, source_ts: Some(source), value,
+            }).unwrap();
+            assert_eq!(result.timestamp, Some(source.into()));
+            assert_eq!(result.value, expected_value);
+        }
+    }
+
+    #[test]
+    fn source_timestamp_roundtrip_does_not_refresh_old_or_future_data() {
+        for seconds in [1_000, 4_000_000_000] {
+            let source = UNIX_EPOCH + Duration::new(seconds, 123_000_000);
+            let input = proto::Datapoint { timestamp: Some(source.into()),
+                value: Some(proto::datapoint::Value::Float(17.0)) };
+            let internal = broker::Datapoint::from(input.clone());
+            assert_eq!(internal.source_ts, Some(source));
+            assert_eq!(Option::<proto::Datapoint>::from(internal), Some(input));
+        }
+    }
+
+    #[test]
+    fn source_timestamp_preserves_batch_across_receipt_millisecond_boundary() {
+        let source = UNIX_EPOCH + Duration::new(1_700_000_000, 0);
+        for index in 0..15 {
+            let datapoint = broker::Datapoint {
+                ts: source + Duration::from_micros(999 + index),
+                source_ts: Some(source), value: broker::DataValue::Float(index as f32),
+            };
+            let entry = proto::DataEntry::from(broker::EntryUpdate {
+                path: Some(format!("Vehicle.Test.Signal{}", index)),
+                datapoint: Some(datapoint), ..Default::default()
+            });
+            assert_eq!(entry.value.unwrap().timestamp, Some(source.into()));
+        }
+    }
+
+    #[test]
+    fn source_timestamp_missing_retains_receipt_fallback() {
+        let receipt = UNIX_EPOCH + Duration::new(1_700_000_000, 987_654_321);
+        for value in values() {
+            let result = Option::<proto::Datapoint>::from(broker::Datapoint {
+                ts: receipt, source_ts: None, value,
+            }).unwrap();
+            assert_eq!(result.timestamp, Some(receipt.into()));
+        }
+    }
+
+    #[test]
+    fn source_timestamp_not_available_stays_absent() {
+        for source_ts in [None, Some(UNIX_EPOCH)] {
+            assert!(Option::<proto::Datapoint>::from(broker::Datapoint {
+                ts: SystemTime::now(), source_ts, value: broker::DataValue::NotAvailable,
+            }).is_none());
+        }
+    }
+
+    #[test]
+    fn source_timestamp_value_only_conversion_has_no_invented_time() {
+        for value in values() {
+            assert!(Option::<proto::Datapoint>::from(value).unwrap().timestamp.is_none());
+        }
+    }
+}
